# Speech-to-text provider.
# `openai` uses the OpenAI audio transcription API. `mock` returns a canned
# transcript and is meant for local development without a key.
STT_PROVIDER=openai

# The API key for the provider. Never expose this to the browser: it is only
# read here, on the server.
OPENAI_API_KEY=

# Optional overrides.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TIMEOUT_MS=120000

# Maximum accepted upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# HTTP server.
PORT=3000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
