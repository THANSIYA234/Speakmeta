# Speech-to-text provider.
# `openai` uses the OpenAI audio transcription API, `minimax` uses MiniMax's
# speech-to-text API, `mock` returns a canned transcript and is meant for local
# development without a key.
STT_PROVIDER=openai

# The API key for the provider. Never expose this to the browser: it is only
# read here, on the server.
OPENAI_API_KEY=

# Optional overrides.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TIMEOUT_MS=120000

# Free OpenAI-compatible alternative (no credit card, 2000 requests/day on the
# free tier). Sign up at https://console.groq.com/keys, then use:
#   STT_PROVIDER=openai
#   OPENAI_API_KEY=<groq key>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Any other endpoint that speaks POST {base}/audio/transcriptions works the
# same way, including a self-hosted whisper server.

# MiniMax speech-to-text. Required when STT_PROVIDER=minimax.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TRANSCRIBE_MODEL=asr-1.0
MINIMAX_TIMEOUT_MS=120000

# ffmpeg binary used to convert the browser's WebM/MP4 recordings, which
# MiniMax's ASR endpoint does not accept. Must be on the PATH.
MINIMAX_FFMPEG_PATH=ffmpeg

# Maximum accepted upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# HTTP server.
PORT=3000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
